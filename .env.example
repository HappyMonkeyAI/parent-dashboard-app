# Copy to untracked .env.local for the web and reminders containers.
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3020
CRON_SECRET=replace-with-a-different-long-random-secret

# Web Push (generate with: pnpm exec web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:notifications@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_PRIVATE_KEY=replace-with-private-key

# Optional email provider; the digest is not scheduled by Compose.
RESEND_API_KEY=

# Copy these to untracked .env.podman for Compose substitution.
# Use the same fresh random database password in both files.
PG_USER=portal
PG_PASSWORD=replace-with-a-random-password
PG_DATABASE=portal
DATABASE_URL=postgresql://portal:replace-with-a-random-password@db:5432/portal
